// SPDX-License-Identifier: GPL-3.0-or-later
//
// Renovate, run by the Mend-hosted GitHub App: no runner or token to maintain.
// Each decision and its reason is in docs/conventions.md (Renovate).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Actions are pinned to commit digests, with the version as a comment: a
    // digest can't be moved under us the way a tag can.
    'helpers:pinGitHubActionDigests',
  ],

  // Weekly: fewer, larger PRs keep review load low.
  schedule: ['* 0-3 * * 1'],

  // Conventional Commits, so Renovate's commits pass the commit check:
  // build(deps) by default; Actions get ci(deps) below.
  semanticCommits: 'enabled',
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',

  // Automerge relies on main's required checks and the repo's rebase merge.
  platformAutomerge: true,
  automergeType: 'pr',
  automergeStrategy: 'rebase',

  // Go modules: go mod tidy after every update, import paths rewritten on
  // major bumps (the runner's import path, in the protocol test, carries
  // its major).
  postUpdateOptions: ['gomodTidy', 'gomodUpdateImportPaths'],

  // Flake inputs: weekly flake.lock maintenance, a PR of its own. Go patch
  // releases and tool updates arrive this way.
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ['* 0-3 * * 1'],
  },

  // The slice's test image, e2e/image: one line, an image pinned by tag and
  // digest, read by the harness's runner label and the protocol test. The
  // docker-compose manager can't read it, so a regex manager keeps its tag
  // and digest current.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^e2e/image$/'],
      matchStrings: ['^(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[0-9a-f]{64})'],
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    // Go modules: build(deps). config:recommended would make them fix(deps).
    {
      matchManagers: ['gomod'],
      semanticCommitType: 'build',
    },
    // The go directive is not a dependency: a Go minor bump is a deliberate
    // change of go.mod and the flake together (docs/development.md).
    {
      matchManagers: ['gomod'],
      matchDepTypes: ['golang', 'toolchain'],
      enabled: false,
    },
    // One automerging group for non-major Go module updates.
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Go modules',
      automerge: true,
    },
    // gvisor follows gvisor-tap-vsock's requirement, through go mod tidy on
    // its updates: Renovate's digest updates would move it to the newest
    // commit of gvisor's default branch, the Bazel tree go get can't build,
    // and off the commit gvisor-tap-vsock was built against.
    {
      matchManagers: ['gomod'],
      matchPackageNames: ['gvisor.dev/gvisor'],
      enabled: false,
    },
    // GitHub Actions: ci(deps), one automerging group for digest and version
    // updates.
    {
      matchManagers: ['github-actions'],
      semanticCommitType: 'ci',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'GitHub Actions',
      automerge: true,
    },
    // Flake inputs arrive only through flake.lock maintenance, not as one PR
    // per input.
    {
      matchManagers: ['nix'],
      matchUpdateTypes: ['major', 'minor', 'patch', 'digest', 'pin', 'pinDigest'],
      enabled: false,
    },
    // Any major update waits for the maintainer.
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // The runner's plugin protocol is the plugin's contract with the runner:
    // its updates wait for the maintainer, in a PR of their own, so they
    // don't hold back the automerging Go group. The harness's runner image
    // (e2e/compose.yaml) is in the same group, so updates to the module and
    // the image that are pending together arrive in one PR. Grouping can't
    // make one wait for the other: a release of only one, or a re-pushed
    // image digest, opens the group's PR with that one alone.
    {
      matchPackageNames: [
        'code.forgejo.org/forgejo/runner',
        'code.forgejo.org/forgejo/runner/**',
        'data.forgejo.org/forgejo/runner',
      ],
      groupName: 'forgejo runner',
      automerge: false,
    },
  ],
}
